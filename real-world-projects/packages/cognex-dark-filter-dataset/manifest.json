{
  "name": "cognex-dark-filter-dataset",
  "version": "1.0.0",
  "scenario": "dataset-collection",
  "description": "Collects frames from a Cognex In-Sight camera, filters out dark/underexposed frames using OpenCV, and writes accepted frames to a local dataset.",
  "entryProfile": "default",
  "pipelineDefinition": "pipeline.json",
  "capturePolicy": {
    "enabled": true,
    "requireProductPresent": false,
    "maxFramesPerCamera": 0,
    "mode": "continuous",
    "preTriggerFramesPerCamera": 0,
    "postTriggerFramesPerCamera": 0,
    "gateEvaluationIntervalFrames": 1
  },
  "productPresenceGate": {
    "mode": "none",
    "moduleId": null
  },
  "frameProcessor": {
    "mode": "none",
    "moduleId": null
  },
  "requiredDirectories": [
    "datasets"
  ]
}
