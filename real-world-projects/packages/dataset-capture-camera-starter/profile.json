{
  "name": "dataset-capture-camera-starter",
  "mode": "dataset-collection-profile",
  "description": "Project-local camera dataset starter package built on top of MachineVisionFabric.Sdk.",
  "capabilities": [
    "dataset-capture",
    "real-world-project",
    "resident-camera-source"
  ],
  "source": {
    "mode": "module",
    "moduleId": "mvf.realworld-camera-starter",
    "config": {
      "sourceFolder": "assets/images",
      "cameraId": "project-cam-1",
      "loop": true,
      "frameIntervalMs": 75,
      "boundedCapacity": 4,
      "maxFrames": 4,
      "deliverMemoryFrames": true
    }
  },
  "simulatorSource": {
    "sourceFolder": "assets/images",
    "loop": true,
    "frameIntervalMs": 75,
    "parallelCameraCount": 1
  }
}
