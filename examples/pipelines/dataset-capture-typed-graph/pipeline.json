{
  "name": "dataset-capture-typed-graph",
  "version": "0.1.0",
  "description": "Example typed graph for future dataset capture execution.",
  "runtimeMode": "headless-dataset-collection",
  "capabilities": [
    "dataset-capture",
    "typed-graph"
  ],
  "nodes": [
    {
      "id": "camera1",
      "displayName": "Camera Source",
      "kind": "integration-module",
      "category": "source",
      "moduleId": "mvf.realworld-cognex-camera",
      "activationMode": "resident",
      "outputs": [
        {
          "name": "frame",
          "channel": "data",
          "dataType": "frame",
          "required": true,
          "allowMultipleEdges": false
        }
      ]
    },
    {
      "id": "presence1",
      "displayName": "If Product Present",
      "kind": "embedded-primitive",
      "category": "flow-control",
      "primitiveType": "if",
      "inputs": [
        {
          "name": "frame",
          "channel": "data",
          "dataType": "frame",
          "required": true,
          "allowMultipleEdges": false
        }
      ],
      "outputs": [
        {
          "name": "acceptedFrame",
          "channel": "data",
          "dataType": "frame",
          "required": true,
          "allowMultipleEdges": false
        }
      ]
    },
    {
      "id": "dark1",
      "displayName": "Dark Frame Gate",
      "kind": "integration-module",
      "category": "compute",
      "moduleId": "mvf.opencv-dark-frame-gate",
      "activationMode": "resident",
      "inputs": [
        {
          "name": "frame",
          "channel": "data",
          "dataType": "frame",
          "required": true,
          "allowMultipleEdges": false
        }
      ],
      "outputs": [
        {
          "name": "frame",
          "channel": "data",
          "dataType": "frame",
          "required": true,
          "allowMultipleEdges": true
        }
      ]
    },
    {
      "id": "save1",
      "displayName": "Dataset Writer",
      "kind": "integration-module",
      "category": "output",
      "moduleId": "mvf.dataset-writer",
      "activationMode": "resident",
      "inputs": [
        {
          "name": "frame",
          "channel": "data",
          "dataType": "frame",
          "required": true,
          "allowMultipleEdges": false
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "edge-1",
      "kind": "data",
      "from": {
        "nodeId": "camera1",
        "port": "frame"
      },
      "to": {
        "nodeId": "presence1",
        "port": "frame"
      }
    },
    {
      "id": "edge-2",
      "kind": "data",
      "from": {
        "nodeId": "presence1",
        "port": "acceptedFrame"
      },
      "to": {
        "nodeId": "dark1",
        "port": "frame"
      }
    },
    {
      "id": "edge-3",
      "kind": "data",
      "from": {
        "nodeId": "dark1",
        "port": "frame"
      },
      "to": {
        "nodeId": "save1",
        "port": "frame"
      }
    }
  ]
}
