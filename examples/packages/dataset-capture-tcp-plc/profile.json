{
  "name": "dataset-capture-tcp-plc",
  "mode": "dataset-collection-profile",
  "description": "Profile that reads product presence through a TCP-backed PLC gate.",
  "capabilities": [
    "dataset-capture",
    "simulator-source"
  ],
  "source": {
    "mode": "module",
    "moduleId": "mvf.folder-source",
    "config": {
      "sourceFolder": "assets/images",
      "loop": true,
      "frameIntervalMs": 250,
      "parallelCameraCount": 2
    }
  },
  "simulatorSource": {
    "sourceFolder": "assets/images",
    "loop": true,
    "frameIntervalMs": 250,
    "parallelCameraCount": 2
  }
}
