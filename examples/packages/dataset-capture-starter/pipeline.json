{
  "name": "dataset-capture-starter",
  "version": "0.1.0",
  "description": "Explicit typed graph for the starter dataset capture package.",
  "runtimeMode": "dataset-collection-profile",
  "capabilities": [
    "dataset-capture",
    "typed-graph"
  ],
  "nodes": [
    {
      "id": "source1",
      "displayName": "Folder Source",
      "kind": "integration-module",
      "category": "source",
      "moduleId": "mvf.folder-source",
      "activationMode": "resident",
      "config": {
        "sourceFolder": "assets/images",
        "loop": false,
        "frameIntervalMs": 0,
        "parallelCameraCount": 1
      },
      "outputs": [
        {
          "name": "frame",
          "channel": "data",
          "dataType": "frame",
          "required": true,
          "allowMultipleEdges": false
        }
      ]
    },
    {
      "id": "gate1",
      "displayName": "Product Present Gate",
      "kind": "integration-module",
      "category": "control",
      "moduleId": "mvf.simulated-gate",
      "activationMode": "resident",
      "config": {
        "enabled": true,
        "productPresent": true
      },
      "outputs": [
        {
          "name": "productPresent",
          "channel": "control",
          "dataType": "boolean-gate",
          "required": true,
          "allowMultipleEdges": false
        }
      ]
    },
    {
      "id": "branch1",
      "displayName": "If Product Present",
      "kind": "embedded-primitive",
      "category": "flow-control",
      "primitiveType": "if",
      "activationMode": "resident",
      "inputs": [
        {
          "name": "frame",
          "channel": "data",
          "dataType": "frame",
          "required": true,
          "allowMultipleEdges": false
        },
        {
          "name": "productPresent",
          "channel": "control",
          "dataType": "boolean-gate",
          "required": true,
          "allowMultipleEdges": false
        }
      ],
      "outputs": [
        {
          "name": "acceptedFrame",
          "channel": "data",
          "dataType": "frame",
          "required": true,
          "allowMultipleEdges": false
        }
      ]
    },
    {
      "id": "sink1",
      "displayName": "Dataset Writer",
      "kind": "integration-module",
      "category": "output",
      "moduleId": "mvf.dataset-writer",
      "activationMode": "resident",
      "config": {
        "outputRoot": "datasets",
        "sessionPrefix": "capture",
        "includeSourcePathInMetadata": false
      },
      "inputs": [
        {
          "name": "frame",
          "channel": "data",
          "dataType": "frame",
          "required": true,
          "allowMultipleEdges": false
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "edge-1",
      "kind": "data",
      "from": {
        "nodeId": "source1",
        "port": "frame"
      },
      "to": {
        "nodeId": "branch1",
        "port": "frame"
      }
    },
    {
      "id": "edge-2",
      "kind": "control",
      "from": {
        "nodeId": "gate1",
        "port": "productPresent"
      },
      "to": {
        "nodeId": "branch1",
        "port": "productPresent"
      }
    },
    {
      "id": "edge-3",
      "kind": "data",
      "from": {
        "nodeId": "branch1",
        "port": "acceptedFrame"
      },
      "to": {
        "nodeId": "sink1",
        "port": "frame"
      }
    }
  ]
}
