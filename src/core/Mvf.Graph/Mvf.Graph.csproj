<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Published so external module authors compile against the same contract the runtime ships,
       and so MachineVisionFabric.Sdk's dependency on it resolves from NuGet. -->
  <PropertyGroup>
    <PackageId>MachineVisionFabric.Graph</PackageId>
    <Version>0.1.0</Version>
    <Authors>MachineVisionFabric contributors</Authors>
    <Description>MachineVisionFabric pipeline graph contract: typed pipeline/node/edge/port definitions shared by the runtime and integration modules.</Description>
    <PackageTags>machine-vision;edge;pipeline;industrial</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/hmetgundogdu/machine-vision-fabric</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

</Project>
