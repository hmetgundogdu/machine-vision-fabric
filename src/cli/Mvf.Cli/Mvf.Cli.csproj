<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Publish size: safe knobs only (no trimming/AOT, so reflection-based config binding
       and dynamic integration-module loading keep working). Compression shrinks the bundled
       assemblies in single-file publish; the feature switches drop runtime features the CLI
       never uses. StackTraceSupport is intentionally left on for diagnostics. -->
  <PropertyGroup>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Mvf.Graph\Mvf.Graph.csproj" />
    <ProjectReference Include="..\..\core\Mvf.Abstractions\Mvf.Abstractions.csproj" />
    <ProjectReference Include="..\..\engine\Mvf.Engine\Mvf.Engine.csproj" />
    <ProjectReference Include="..\..\hosting\Mvf.Hosting.Worker\Mvf.Hosting.Worker.csproj" />
    <ProjectReference Include="..\..\transports\Mvf.Transport.SharedMemory\Mvf.Transport.SharedMemory.csproj" />
  </ItemGroup>

</Project>
